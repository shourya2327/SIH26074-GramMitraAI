# GramMitraAI Weather & AI Service Environment Configuration
# Open-Meteo is free and does not require an API key by default.
# If you have an Open-Meteo commercial API key or another provider key, provide it here.
VITE_WEATHER_API_KEY=
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# AI/ML Backend Microservice URL (FastAPI)
VITE_AI_SERVICE_URL=http://localhost:8000

# Spring Boot Backend API URL
VITE_BACKEND_API_URL=http://localhost:8080/api
